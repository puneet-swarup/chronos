<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately no <monochrome> here: that element arrived in API 33, and launchers
     on API 26-32 fail to inflate an adaptive icon that contains it, falling back to
     a cached or default icon. The themed variant lives in mipmap-anydpi-v33. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
